{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "NestJS and PostgreSQL API for creating, listing, and updating the status of tasks. The [React frontend](https://github.com/guillerg01/react-node-task-manager-web) lives in a separate repository.",
  "main": "dist/src/main.js",
  "scripts": {
    "test": "vitest run --config vitest.config.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "node scripts/test-integration.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillerg01/react-node-task-manager-api.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/guillerg01/react-node-task-manager-api/issues"
  },
  "homepage": "https://github.com/guillerg01/react-node-task-manager-api#readme",
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/typeorm": "12.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=26 <27"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
